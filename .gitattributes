# Enforce LF line endings for all text files
* text=auto eol=lf

# Explicitly mark binary files
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary

# Shell scripts must remain executable with LF
*.sh text eol=lf
mvnw text eol=lf

# Windows batch files require CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
